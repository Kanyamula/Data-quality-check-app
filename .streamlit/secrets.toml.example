# Optional: GitHub-backed persistence for the "upload history" feature.
#
# The app works perfectly well without this file -- upload history just
# stays in memory for the current session instead of being saved across
# restarts. To enable persistence:
#
#   1. Copy this file to .streamlit/secrets.toml (that exact path/name).
#   2. Create a GitHub repo to store the history JSON file in (can be the
#      same repo as this app, or a separate private one).
#   3. Create a GitHub Personal Access Token with "repo" (contents) write
#      access: https://github.com/settings/tokens
#   4. Fill in the values below.
#
# .streamlit/secrets.toml is already in .gitignore -- never commit your
# real token.

GITHUB_TOKEN = "ghp_your_personal_access_token_here"
GITHUB_REPO = "your-username/your-repo-name"

# Optional, shown with their defaults:
# HISTORY_PATH = "history/upload_history.json"
# BRANCH = "main"
